{"schemaVersion":1,"unitId":"u015","words":[{"word":"bedroom","meanings":[{"meaning":"卧室","pos":"n"}]},{"word":"untidy","meanings":[{"meaning":"乱，不整齐","pos":"adj"}]},{"word":"wardrobe","meanings":[{"meaning":"大衣柜","pos":"n"}]},{"word":"clothes","meanings":[{"meaning":"衣服","pos":"n"}]},{"word":"must","meanings":[{"meaning":"modal verb 必须，应该"}]},{"word":"air","meanings":[{"meaning":"使 … 通风，换换空气","pos":"v"}]},{"word":"dust","meanings":[{"meaning":"掸掉灰尘土","pos":"v"}]},{"word":"sweep","meanings":[{"meaning":"扫","pos":"v"}]},{"word":"floor","phonetic":"/flɔː/","meanings":[{"meaning":"地板，地面","pos":"noun","usage":"房间的地面部分"}]},{"word":"window","phonetic":"/ˈwɪndəʊ/","meanings":[{"meaning":"窗户","pos":"noun","usage":"建筑物墙壁上的开口，用于采光通风"}]},{"word":"door","phonetic":"/dɔː/","meanings":[{"meaning":"门","pos":"noun","usage":"用于进出房间的开口"}]},{"word":"shut","meanings":[{"meaning":"关门","pos":"v"}]},{"word":"open","meanings":[{"meaning":"打开","pos":"v"}]},{"word":"put","meanings":[{"meaning":"放置","pos":"v"}]}],"phrases":[{"phrase":"Come in","usage":"用于邀请别人进入房间","examples":[{"en":"Come in, Amy.","zh":"进来吧，艾米。"}]},{"phrase":"Shut the door","usage":"请求或命令他人关上门","examples":[{"en":"Shut the door, please.","zh":"请把门关上。"}]},{"phrase":"open the window","usage":"打开窗户以通风换气","examples":[{"en":"Open the window and air the room.","zh":"打开窗户，让房间通风。"}]},{"phrase":"put these clothes in the wardrobe","usage":"把衣服放到衣柜里","examples":[{"en":"Put these clothes in the wardrobe.","zh":"把这些衣服放进衣柜里。"}]},{"phrase":"make the bed","usage":"整理床铺，铺床","examples":[{"en":"Then make the bed.","zh":"然后整理床铺。"}]},{"phrase":"dust the dressing table","usage":"拂去梳妆台上的灰尘","examples":[{"en":"Dust the dressing table.","zh":"拂去梳妆台上的灰尘。"}]},{"phrase":"sweep the floor","usage":"用扫帚清扫地面","examples":[{"en":"Then sweep the floor.","zh":"然后扫地。"}]},{"phrase":"dressing table","usage":"/ˈdresɪŋ ˈteɪbl/ noun. 梳妆台（卧室里用于梳妆的桌子）","examples":[]}],"grammar":[{"title":"Must 用于表达义务和指令","structure":"Must + 动词原形","definition":"must是情态动词，表示'必须'，用于表达权威人士给