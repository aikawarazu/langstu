     "speaker": "DAN",
     "en": "You're working hard, George."
    },
    {
     "i": 1,
     "speaker": "GEORGE",
     "en": "What are you doing?"
    },
    {
     "i": 2,
     "speaker": "GEORGE",
     "en": "I'm making a bookcase."
    },
    {
     "i": 3,
     "speaker": "GEORGE",
     "en": "Give me that hammer please, Dan."
    },
    {
     "i": 4,
     "speaker": "DAN",
     "en": "Which hammer."
    },
    {
     "i": 5,
     "speaker": "DAN",
     "en": "This one?"
    },
    {
     "i": 6,
     "speaker": "GEORGE",
     "en": "No, not that one."
    },
    {
     "i": 7,
     "speaker": "GEORGE",
     "en": "The big one."
    },
    {
     "i": 8,
     "speaker": "DAN",
     "en": "Here you are."
    },
    {
     "i": 9,
     "speaker": "GEORGE",
     "en": "Thanks, Dan."
    },
    {
     "i": 10,
     "speaker": "DAN",
     "en": "What are you going to do now, George?"
    },
    {
     "i": 11,
     "speaker": "GEORGE",
     "en": "I'm going to paint it."
    },
    {
     "i": 12,
     "speaker": "DAN",
     "en": "What colour are you going to paint it?"
    },
    {
     "i": 13,
     "speaker": "GEORGE",
     "en": "I'm going to paint it pink."
    },
    {
     "i": 14,
     "speaker": "DAN",
     "en": "Pink!"
    },
    {
     "i": 15,
     "speaker": "GEORGE",
     "en": "This bookcase isn't for me."
    },
    {
     "i": 16,
     "speaker": "GEORGE",
     "en": "It's for my daughter, Susan."
    },
    {
     "i": 17,
     "speaker": "GEORGE",
     "en": "Pink's her favorite colour."
    }
