   "lesson": 17,
   "zh": [
    {
     "i": 0,
     "zh": "来见见我们的雇员，理查兹先生。"
    },
    {
     "i": 1,
     "zh": "谢谢你，杰克逊先生。"
    },
    {
     "i": 2,
     "zh": "这位是尼古拉·格雷，这位是克莱尔·泰勒。"
    },
    {
     "i": 3,
     "zh": "你好！"
    },
    {
     "i": 4,
     "zh": "那些姑娘很勤奋。"
    },
    {
     "i": 5,
     "zh": "她们是做什么工作的？"
    },
    {
     "i": 6,
     "zh": "她们是键盘操作员。"
    },
    {
     "i": 7,
     "zh": "这位是迈克尔·贝克，这位是杰里米·肖特。"
    },
    {
     "i": 8,
     "zh": "你好！"
    },
    {
     "i": 9,
     "zh": "他们不太忙！"
    },
    {
     "i": 10,
     "zh": "他们是做什么工作的？"
    },
    {
     "i": 11,
     "zh": "他们是推销员。"
    },
    {
     "i": 12,
     "zh": "他们很懒。"
    },
    {
     "i": 13,
     "zh": "这位年轻人是谁？"
    },
    {
     "i": 14,
     "zh": "这是吉姆。"
    },
    {
     "i": 15,
     "zh": "他是我们的办公室助理。"
    }
   ]
  }
 ]
}