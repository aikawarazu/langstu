 "unitId": "u022",
 "lessons": [
  {
   "lesson": 43,
   "zh": [
    {
     "i": 0,
     "zh": "你会沏茶吗，萨姆？"
    },
    {
     "i": 1,
     "zh": "会的，我当然会，彭妮。"
    },
    {
     "i": 2,
     "zh": "这水壶里有水吗？"
    },
    {
     "i": 3,
     "zh": "有水。"
    },
    {
     "i": 4,
     "zh": "茶叶在哪儿？"
    },
    {
     "i": 5,
     "zh": "就在那儿，茶壶后面。你看见了吗？"
    },
    {
     "i": 6,
     "zh": "茶壶我看见了，但茶叶没看到。"
    },
    {
     "i": 7,
     "zh": "那不是么！就在你眼前。"
    },
    {
     "i": 8,
     "zh": "噢，是啊，我现在看到了。"
    },
    {
     "i": 9,
     "zh": "茶杯在哪儿呢？"
    },
    {
     "i": 10,
     "zh": "碗橱里有几只。"
    },
    {
     "i": 11,
     "zh": "你找得到吗？"
    },
    {
     "i": 12,
     "zh": "找得到。就在这儿呢。"
    },
    {
     "i": 13,
     "zh": "快，萨姆。水开了！"
    }
   ]
  }
 ]
}