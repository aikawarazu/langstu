   "zh": [
    {
     "i": 0,
     "zh": "史密斯夫人的厨房很小。"
    },
    {
     "i": 1,
     "zh": "厨房里有个电冰箱。"
    },
    {
     "i": 2,
     "zh": "冰箱的颜色是白的。"
    },
    {
     "i": 3,
     "zh": "它位于房间右侧。"
    },
    {
     "i": 4,
     "zh": "厨房里有个电灶。"
    },
    {
     "i": 5,
     "zh": "电灶的颜色是蓝的。"
    },
    {
     "i": 6,
     "zh": "它位于房间左侧。"
    },
    {
     "i": 7,
     "zh": "房间的中央有张桌子。"
    },
    {
     "i": 8,
     "zh": "桌子上有个瓶子。"
    },
    {
     "i": 9,
     "zh": "瓶子是空的。"
    },
    {
     "i": 10,
     "zh": "桌子上还有一只杯子。"
    },
    {
     "i": 11,
     "zh": "杯子很干净。"
    }
   ]
  }
 ]
}