{
 "unitId": "u019",
 "lessons": [
  {
   "lesson": 37,
   "zh": [
    {
     "i": 0,
     "zh": "你干得真辛苦，乔治。"
    },
    {
     "i": 1,
     "zh": "你在干什么呢？"
    },
    {
     "i": 2,
     "zh": "我正在做书架。"
    },
    {
     "i": 3,
     "zh": "请把那把锤子拿给我，丹。"
    },
    {
     "i": 4,
     "zh": "哪一把？"
    },
    {
     "i": 5,
     "zh": "是这把吗？"
    },
    {
     "i": 6,
     "zh": "不，不是那把。"
    },
    {
     "i": 7,
     "zh": "是那把大的。"
    },
    {
     "i": 8,
     "zh": "给你。"
    },
    {
     "i": 9,
     "zh": "谢谢，丹。"
    },
    {
     "i": 10,
     "zh": "你现在打算干什么，乔治？"
    },
    {
     "i": 11,
     "zh": "我打算把它漆一下。"
    },
    {
     "i": 12,
     "zh": "你打算把它漆成什么颜色？"
    },
    {
     "i": 13,
     "zh": "我打算把它漆成粉红色。"
    },
    {
     "i": 14,
     "zh": "粉红色！"
    },
    {
     "i": 15,
     "zh": "这个书架不是为我做的。"
    },
    {
     "i": 16,
     "zh": "是为我的女儿苏珊做的。"
    },
    {
     "i": 17,
     "zh": "粉红色是她最喜欢的颜色。"
    }
   ]
  }
 ]
}