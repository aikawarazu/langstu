   "lesson": 15,
   "zh": [
    {
     "i": 0,
     "zh": "请出示你们的护照。"
    },
    {
     "i": 1,
     "zh": "你们是瑞典人吗？"
    },
    {
     "i": 2,
     "zh": "不，我们不是瑞典人。"
    },
    {
     "i": 3,
     "zh": "我们是丹麦人。"
    },
    {
     "i": 4,
     "zh": "你们的朋友也是丹麦人吗？"
    },
    {
     "i": 5,
     "zh": "不，他们不是丹麦人。"
    },
    {
     "i": 6,
     "zh": "他们是挪威人。"
    },
    {
     "i": 7,
     "zh": "请出示你们的护照。"
    },
    {
     "i": 8,
     "zh": "给您。"
    },
    {
     "i": 9,
     "zh": "这些是你们的箱子吗？"
    },
    {
     "i": 10,
     "zh": "不，不是。我们的箱子是棕色的。"
    },
    {
     "i": 11,
     "zh": "在这儿呢。"
    },
    {
     "i": 12,
     "zh": "你们是来旅游的吗？"
    },
    {
     "i": 13,
     "zh": "是的，我们是来旅游的。"
    },
    {
     "i": 14,
     "zh": "你们的朋友也是来旅游的吗？"
    },
    {
     "i": 15,
     "zh": "是的，他们也是。"
    },
    {
     "i": 16,
     "zh": "好了。"
    },
    {
     "i": 17,
     "zh": "非常感谢。"
    }
   ]
  }
 ]
}