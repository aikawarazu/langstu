 "unitId": "u025",
 "lessons": [
  {
   "lesson": 49,
   "zh": [
    {
     "i": 0,
     "zh": "您今天要买点肉吗，伯德夫人？"
    },
    {
     "i": 1,
     "zh": "是的，我买一点。"
    },
    {
     "i": 2,
     "zh": "您要牛肉还是要羔羊肉？"
    },
    {
     "i": 3,
     "zh": "请给我牛肉。"
    },
    {
     "i": 4,
     "zh": "这羔羊肉很好。"
    },
    {
     "i": 5,
     "zh": "我喜欢羔羊肉，可我丈夫不喜欢。"
    },
    {
     "i": 6,
     "zh": "来点牛排吗？这块很好。"
    },
    {
     "i": 7,
     "zh": "就请给我那块吧。"
    },
    {
     "i": 8,
     "zh": "再来一磅绞肉。"
    },
    {
     "i": 9,
     "zh": "您要买只鸡吗，伯德夫人？这些鸡很好。"
    },
    {
     "i": 10,
     "zh": "不要了，谢谢。"
    },
    {
     "i": 11,
     "zh": "我丈夫喜欢牛排，但他不喜欢鸡。"
    },
    {
     "i": 12,
     "zh": "说老实话，伯德夫人，我也不喜欢鸡。"
    }
   ]
  }
 ]
}