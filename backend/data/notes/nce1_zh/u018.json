  {
   "lesson": 35,
   "zh": [
    {
     "i": 0,
     "zh": "我们的村庄坐落在一个山谷之中。"
    },
    {
     "i": 1,
     "zh": "它位于两座小山之间。"
    },
    {
     "i": 2,
     "zh": "它靠近一条小河。"
    },
    {
     "i": 3,
     "zh": "这是我们村庄的另一张照片。"
    },
    {
     "i": 4,
     "zh": "我和妻子正沿着河岸走着。"
    },
    {
     "i": 5,
     "zh": "我们在河的左侧。"
    },
    {
     "i": 6,
     "zh": "河里面有个男孩。"
    },
    {
     "i": 7,
     "zh": "他正横渡小河。"
    },
    {
     "i": 8,
     "zh": "这是另一张照片。"
    },
    {
     "i": 9,
     "zh": "这是学校大楼。"
    },
    {
     "i": 10,
     "zh": "它位于公园的旁边。"
    },
    {
     "i": 11,
     "zh": "公园在右面。"
    },
    {
     "i": 12,
     "zh": "一些孩子正从楼里出来。"
    },
    {
     "i": 13,
     "zh": "他们中有几个正走进公园。"
    }
   ]
  }
 ]
}