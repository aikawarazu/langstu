  {
   "lesson": 27,
   "zh": [
    {
     "i": 0,
     "zh": "史密斯夫人的客厅很大。"
    },
    {
     "i": 1,
     "zh": "客厅里有台电视机。"
    },
    {
     "i": 2,
     "zh": "电视机靠近窗子。"
    },
    {
     "i": 3,
     "zh": "电视机上放着几本杂志。"
    },
    {
     "i": 4,
     "zh": "客厅里有张桌子。"
    },
    {
     "i": 5,
     "zh": "桌上放着几份报纸。"
    },
    {
     "i": 6,
     "zh": "客厅里有几把扶手椅。"
    },
    {
     "i": 7,
     "zh": "那些扶手椅靠近桌子。"
    },
    {
     "i": 8,
     "zh": "客厅里有台立体声音响。"
    },
    {
     "i": 9,
     "zh": "音响靠近门。"
    },
    {
     "i": 10,
     "zh": "音响上面有几本书。"
    },
    {
     "i": 11,
     "zh": "客厅里有几幅画。"
    },
    {
     "i": 12,
     "zh": "画挂在墙上。"
    }
   ]
  }
 ]
}