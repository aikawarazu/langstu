 "lessons": [
  {
   "lesson": 45,
   "zh": [
    {
     "i": 0,
     "zh": "请你来一下好吗？鲍勃？"
    },
    {
     "i": 1,
     "zh": "什么事，先生？"
    },
    {
     "i": 2,
     "zh": "帕梅拉在哪儿？"
    },
    {
     "i": 3,
     "zh": "她在隔壁，在她的办公室里，先生。"
    },
    {
     "i": 4,
     "zh": "她能为我打一下这封信吗？请问她。"
    },
    {
     "i": 5,
     "zh": "好的，先生。"
    },
    {
     "i": 6,
     "zh": "请你把这封信给老板打一下可以吗，帕梅拉？"
    },
    {
     "i": 7,
     "zh": "可以，当然可以。"
    },
    {
     "i": 8,
     "zh": "给你。"
    },
    {
     "i": 9,
     "zh": "谢谢你，鲍勃。"
    },
    {
     "i": 10,
     "zh": "鲍勃！"
    },
    {
     "i": 11,
     "zh": "怎么了？"
    },
    {
     "i": 12,
     "zh": "怎么回事？"
    },
    {
     "i": 13,
     "zh": "我打不了这封信。"
    },
    {
     "i": 14,
     "zh": "我看不懂这封信！"
    },
    {
     "i": 15,
     "zh": "老板的书写太糟糕了！"
    }
   ]
  }
 ]
}