{"schemaVersion":1,"unitId":"u015","words":[{"word":"bedroom","phonetic":"/ˈbedruːm/","meanings":[{"meaning":"卧室","pos":"noun","usage":"指供人睡觉的房间"}]},{"word":"untidy","phonetic":"/ʌnˈtaɪdi/","meanings":[{"meaning":"不整洁的，凌乱的","pos":"adjective","usage":"形容房间或物品没有整理干净"}]},{"word":"wardrobe","phonetic":"/ˈwɔːdrəʊb/","meanings":[{"meaning":"衣柜，衣橱","pos":"noun","usage":"用于存放衣服的家具"}]},{"word":"clothes","phonetic":"/kləʊðz/","meanings":[{"meaning":"衣服，服装","pos":"noun","usage":"复数名词，指各种衣物"}]},{"word":"must","phonetic":"/mʌst/","meanings":[{"meaning":"modal verb. 必须，应当","usage":"表示义务或命令，用于给指令"}]},{"word":"air","phonetic":"/eə/","meanings":[{"meaning":"通风，晾干","pos":"verb","usage":"打开窗户让空气流通"}]},{"word":"dust","phonetic":"/dʌst/","meanings":[{"meaning":"拂去灰尘","pos":"verb","usage":"用布擦拭去除灰尘"}]},{"word":"sweep","phonetic":"/swiːp/","meanings":[{"meaning":"扫地，扫除","pos":"verb","usage":"用扫帚清理地面"}]},{"word":"floor","phonetic":"/flɔː/","meanings":[{"meaning":"地板，地面","pos":"noun","usage":"房间的地面部分"}]},{"word":"window","phonetic":"/ˈwɪndəʊ/","meanings":[{"meaning":"窗户","pos":"noun","usage":"建筑物墙壁上的开口，用于采光通风"}]},{"word":"door","phonetic":"/dɔː/","meanings":[{"meaning":"门","pos":"noun","usage":"用于进出房间的开口"}]}],"phrases":[{"phrase":"Come in","usage":"用于邀请别人进入房间","examples":[{"en":"Come in, Amy.","zh":"进来吧，艾米。"}]},{"phrase":"Shut the door","usage":"请求或命令他人关上门","examples":[{"en":"Shut the door, please.","zh":"请把门关上。"}]},{"phrase":"open the window","usage":"打开窗户以通风换气","examples":[{"en":"Open the window and air the room.","zh":"打开窗户，让房间通风。"}]},{"phrase":"put these clothes in the wardrobe","usage":"把衣服放到衣柜里","examples":[{"en":"Put these clothes in the wardrobe.","zh":"把这些衣服放进衣柜里。"}]},{"phrase":"make the bed","usage":"整理床铺，铺床","examples":[{"en":"Then make the bed.","zh":"然后整理床铺。"}]},{"phrase":"dust the dressing table","usage":"拂去梳妆台上的灰尘","examples":[{"en":"Dust the dressing table.","zh":"拂去梳妆台上的灰尘。"}]},{"phrase":"sweep the floor","usage":"用扫帚清扫地面","examples":[{"en":"Then sweep the floor.","zh":"然后扫